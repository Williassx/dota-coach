<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/intervention_request.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/orders_state.js" />
        <include src="file://{resources}/scripts/custom_game/intervention_request_state.js" />
        <include src="file://{resources}/scripts/custom_game/intervention_request_panel.js" />
    </scripts>
    <Panel id="ManualRequestRoot" class="ManualRequestScreen" hittest="false" hittestchildren="true">
        <Panel class="ManualRequestWindow" hittest="true" hittestchildren="true">
            <Label class="ManualRequestTitle" html="false" text="Запрос ручного управления" />
            <Label class="ManualRequestHeading" html="false" text="Выбранный игрок" />
            <Label id="ManualRequestRecipient" class="ManualRequestText" html="false" text="Игрок не выбран или снимок недоступен." />
            <Label id="ManualRequestMode" class="ManualRequestText" html="false" text="Снимок недоступен." />
            <Label class="ManualRequestHeading" html="false" text="Адресат и состояние запроса" />
            <Label id="ManualRequestActor" class="ManualRequestText" html="false" text="Нет адресата запроса." />
            <Label id="ManualRequestState" class="ManualRequestText" html="false" text="Нет текущего запроса." />
            <Label id="ManualRequestReason" class="ManualRequestText" html="false" />
            <Label id="ManualRequestMessage" class="ManualRequestText" html="false" text="Переходник не подключён; ручной ввод недоступен." />
            <Button id="ManualRequestButton" class="ManualRequestControl" enabled="false">
                <Label id="ManualRequestHint" class="ManualRequestText" html="false" text="Запросить ручное управление" />
            </Button>
        </Panel>
    </Panel>
</root>
